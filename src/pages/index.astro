---
import LabsLayout from '../layouts/LabsLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import { skills, GITHUB_REPO_URL } from '../data/skills';

const meta = {
  title: 'Edelstein Labs · AI-Skills zum Herunterladen',
  description:
    'Selbstgebaute Claude-Skills für Marken- und Content-Arbeit. Kostenlos herunterladen, in claude.ai oder Claude Code installieren, sofort einsatzbereit.',
  canonical: 'https://labs.edelsteinstrategie.de/',
};

const triggers = [...new Set(skills.flatMap((s) => s.triggers))];

const ctaCalendly = 'https://calendly.com/luis-edelsteinstrategie/edelstein-intro-call';

const numberWords = ['Null', 'Ein', 'Zwei', 'Drei', 'Vier', 'Fünf', 'Sechs', 'Sieben', 'Acht', 'Neun', 'Zehn'];
const skillCount = numberWords[skills.length] ?? String(skills.length);

const whyFree = {
  intro: [
    'Berechtigte Frage: Wenn ich oben schreibe, dass ich damit meine Markenarbeit mache – sparst du dir dann den Strategen? Nein. Und das ist kein Verkaufsspruch.',
    'AI ist für mich ein Werkzeug wie viele andere. Ich recherchiere damit, automatisiere Prozesse, halte Dinge strukturiert. Es nimmt mir Fleißarbeit ab – nicht das Denken.',
  ],
  skill: ['Recherche beschleunigen', 'Prozesse automatisieren', 'Struktur, Formate, Wiederholbares', 'Erste Entwürfe, schnell'],
  human: [
    'Zusammenhänge wirklich verstehen',
    'Tief bohren, bis es wehtut',
    'Mit Menschen reden – auch mit den Kunden meiner Kunden',
    'Verbindungen herstellen, die keiner sieht',
    'Kreative Inspiration',
  ],
  outro: [
    'Dieser Kern lässt sich nicht herunterladen. Er kommt aus meiner Art zu denken, zu fragen, zuzuhören. Genau deshalb teile ich die Skills ohne Bauchschmerzen: Wer gut in Branding ist, nutzt sie, um sich selbst zu verstärken. Wer einfach rumprobieren will, auch.',
    'Wie bei jedem Werkzeug gilt: Wer nicht weiß, was er tut, kommt auch mit dem besten nicht weit. Bei AI ist das kein bisschen anders.',
  ],
};
---
<LabsLayout {...meta}>
  <!-- Hero: dot-matrix field with the wordmark's slash as a sweeping signal -->
  <section class="hero">
    <canvas class="field" aria-hidden="true"></canvas>
    <div class="coords mono" aria-hidden="true">
      <span>Edelstein · Labs</span><span class="hide-s">Signal / Werkbank</span><span><span class="led"></span> live</span>
    </div>
    <div class="wrap">
      <div>
        <h1>Arbeit, die Tage frisst. Erledigt in <em>Minuten.</em></h1>
        <p class="hero-lead">Die spezialisierten AI-Skills, mit denen ich Marken baue – Strategie, Video-Skripte, Design-Systeme. Kostenlos, in jedem LLM nutzbar, in Minuten startklar.</p>
        <div class="btns">
          <a class="btn btn--o" href="#skills">Skills ansehen <span aria-hidden="true">↓</span></a>
          <a class="btn btn--line" href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">Auf GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="readout" aria-label="Kennzahlen">
        <div class="readout-head mono"><span>Readout</span><span class="led"></span></div>
        <dl>
          <div><dt class="mono">Skills</dt><dd>{skills.length}</dd></div>
          <div><dt class="mono">Auslöser</dt><dd>{triggers.length}</dd></div>
          <div><dt class="mono">Preis</dt><dd>0<small>€</small></dd></div>
          <div><dt class="mono">Start</dt><dd>&lt;5<small>Min</small></dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="sec" id="skills">
    <div class="wrap">
      <div class="sec-head">
        <div><h2>{skillCount} Skills, die ich selbst in <em>Kundenprojekten</em> nutze.</h2></div>
        <p class="support">Spezialisiert, ohne Interna, in jedem LLM startklar. Herunterladen, einbinden, loslegen.</p>
      </div>
      <div class="mods">
        {skills.map((skill) => <SkillCard skill={skill} />)}
      </div>
    </div>
  </section>

  <section class="sec why">
    <div class="wrap">
      <div class="sec-head">
        <div><h2>Diese Skills ersetzen keine Markenarbeit. Sie <em>verstärken</em> sie.</h2></div>
        <div class="why-intro">{whyFree.intro.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="sn">
        <div class="noise">
          <h3><span>Was die Skills übernehmen</span><span>Rauschen</span></h3>
          <ul>{whyFree.skill.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="signal">
          <h3><span>Was bei mir bleibt</span><span class="o">Signal</span></h3>
          <ul>{whyFree.human.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
      <div class="why-out">{whyFree.outro.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="cta">
    <span class="slash" aria-hidden="true">/</span>
    <div class="wrap">
      <h2>Steckt deine Marke an einer Stelle fest, die kein Skill löst?</h2>
      <div class="cta-row">
        <p>Genau da fange ich an. Lass uns 15 Minuten reden – unverbindlich und ehrlich. Wenn ich nicht der Richtige bin, sage ich dir das.</p>
        <div>
          <a class="btn btn--o" href={ctaCalendly} target="_blank" rel="noopener noreferrer">Lass uns reden <span aria-hidden="true">→</span></a>
          <p class="note mono">15 Min · unverbindlich · kein Pitch</p>
        </div>
      </div>
    </div>
  </section>
</LabsLayout>
