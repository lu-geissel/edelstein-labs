---
import LabsLayout from '../layouts/LabsLayout.astro';
import HeroDeck from '../components/HeroDeck.astro';
import SkillCard from '../components/SkillCard.astro';
import { skills, GITHUB_REPO_URL } from '../data/skills';

const meta = {
  title: 'Edelstein Labs · AI-Skills zum Herunterladen',
  description:
    'Selbstgebaute Claude-Skills für Marken- und Content-Arbeit. Kostenlos herunterladen, in claude.ai oder Claude Code installieren, sofort einsatzbereit.',
  canonical: 'https://labs.edelsteinstrategie.de/',
};

const triggers = [...new Set(skills.flatMap((s) => s.triggers))];

const ctaCalendly = 'https://calendly.com/luis-edelsteinstrategie/edelstein-intro-call';
---
<LabsLayout {...meta}>
  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-screen flex items-center overflow-hidden pt-16">
    <!-- background video -->
    <div class="absolute inset-0 -z-10">
      <video
        class="w-full h-full object-cover opacity-50"
        autoplay muted loop playsinline preload="metadata"
        poster="/labs/video/hero-poster.jpg"
      >
        <source src="/labs/video/hero.webm" type="video/webm" />
        <source src="/labs/video/hero.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,18,14,.65)_0%,rgba(10,18,14,.45)_40%,rgba(10,18,14,.92)_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_20%_30%,rgba(91,44,111,.35),transparent_60%)]"></div>
    </div>

    <div class="max-w-6xl mx-auto px-5 md:px-8 w-full grid lg:grid-cols-2 gap-12 lg:gap-8 items-center py-20">
      <!-- copy -->
      <div data-animate>
        <span class="mono-label text-gem-purple-light/90 inline-flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gem-purple-light dot-glow text-gem-purple-light"></span>
          Edelstein · Labs
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-deep-beige leading-[1.05] mt-5">
          Arbeit, die Tage frisst.
          <br class="hidden sm:block" />Erledigt in <span class="text-gem-purple-light">Minuten</span>.
        </h1>
        <p class="text-lg text-deep-beige/65 leading-relaxed mt-6 max-w-xl">
          Die spezialisierten AI-Skills, mit denen ich Marken baue – Strategie, Video-Skripte,
          Design-Systeme. Kostenlos, in jedem LLM nutzbar, in Minuten startklar.
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-9">
          <a href="#skills"
             class="inline-flex items-center gap-2 mono-label text-deep-beige bg-gem-purple hover:bg-gem-purple-light transition-colors px-6 py-3.5">
            Skills ansehen <span aria-hidden="true">↓</span>
          </a>
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 mono-label text-deep-beige/80 border border-deep-beige/25 hover:border-gem-purple-light/70 hover:text-deep-beige transition-colors px-6 py-3.5">
            Auf GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- floating snapshot deck -->
      <div data-animate data-delay="150" class="relative">
        <HeroDeck />
      </div>
    </div>

    <!-- scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 mono-label text-deep-beige/35 animate-float">scroll</div>
  </section>

  <!-- ==================== TRIGGER MARQUEE ==================== -->
  <div class="relative border-y border-[color:var(--color-labs-line)] py-4 overflow-hidden">
    <div class="marquee-track gap-8">
      {[...triggers, ...triggers].map((t) => (
        <span class="mono-label text-deep-beige/30 flex items-center gap-8">
          {t} <span class="text-gem-purple-light/40">◆</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ==================== SKILLS GRID ==================== -->
  <section id="skills" class="max-w-6xl mx-auto px-5 md:px-8 py-24 md:py-32 scroll-mt-20">
    <div data-animate class="mb-14 max-w-2xl">
      <span class="mono-label text-gem-purple-light/80">Verfügbare Skills · {skills.length}</span>
      <h2 class="font-serif text-3xl md:text-4xl text-deep-beige leading-tight mt-4">
        Drei Skills, die ich selbst täglich nutze.
      </h2>
      <p class="text-deep-beige/55 leading-relaxed mt-4">
        Spezialisiert, ohne Interna, in jedem LLM startklar. Herunterladen, einbinden, loslegen.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skills.map((skill, i) => (
        <SkillCard skill={skill} delay={i * 120} />
      ))}
    </div>
  </section>

  <!-- ==================== WARUM KOSTENLOS ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 pb-24 md:pb-32">
    <div data-animate class="max-w-2xl mb-12">
      <span class="mono-label text-gem-purple-light/80">Warum kostenlos?</span>
      <h2 class="font-serif text-3xl md:text-4xl text-deep-beige leading-tight mt-4">
        Diese Skills ersetzen keine Markenarbeit. Sie verstärken sie.
      </h2>
      <p class="text-deep-beige/60 leading-relaxed mt-5">
        Berechtigte Frage: Wenn ich oben schreibe, dass ich damit meine Markenarbeit mache –
        sparst du dir dann den Strategen? Nein. Und das ist kein Verkaufsspruch.
      </p>
      <p class="text-deep-beige/60 leading-relaxed mt-4">
        AI ist für mich ein Werkzeug wie viele andere. Ich recherchiere damit, automatisiere
        Prozesse, halte Dinge strukturiert. Es nimmt mir Fleißarbeit ab – nicht das Denken.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <div data-animate class="glass p-7 md:p-8">
        <div class="mono-label text-deep-beige/55 mb-6">Was die Skills übernehmen</div>
        <ul class="space-y-3.5">
          {[
            'Recherche beschleunigen',
            'Prozesse automatisieren',
            'Struktur, Formate, Wiederholbares',
            'Erste Entwürfe, schnell',
          ].map((item) => (
            <li class="flex items-baseline gap-3 text-deep-beige/70 leading-relaxed">
              <span class="text-deep-beige/30 text-xs mt-1.5 shrink-0">●</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div data-animate data-delay="120" class="glass-strong p-7 md:p-8">
        <div class="mono-label text-labs-green mb-6">Was bei mir bleibt</div>
        <ul class="space-y-3.5">
          {[
            'Zusammenhänge wirklich verstehen',
            'Tief bohren, bis es wehtut',
            'Mit Menschen reden – auch mit den Kunden meiner Kunden',
            'Verbindungen herstellen, die keiner sieht',
            'Kreative Inspiration',
          ].map((item) => (
            <li class="flex items-baseline gap-3 text-deep-beige/90 leading-relaxed">
              <span class="text-labs-green text-xs mt-1.5 shrink-0">●</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div data-animate class="max-w-3xl mt-10">
      <p class="text-lg text-deep-beige/70 leading-relaxed">
        Dieser Kern lässt sich nicht herunterladen. Er kommt aus meiner Art zu denken, zu fragen,
        zuzuhören. Genau deshalb teile ich die Skills ohne Bauchschmerzen: Wer gut in Branding ist,
        nutzt sie, um sich selbst zu verstärken. Wer einfach rumprobieren will, auch.
      </p>
      <p class="text-lg text-deep-beige/70 leading-relaxed mt-4">
        Wie bei jedem Werkzeug gilt: Wer nicht weiß, was er tut, kommt auch mit dem besten nicht
        weit. Bei AI ist das kein bisschen anders.
      </p>
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section class="relative overflow-hidden border-t border-[color:var(--color-labs-line)]">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="glow-blob glow-blob--violet animate-glow" style="width:720px;height:720px;left:50%;top:48%;transform:translate(-50%,-50%);opacity:.45;"></div>
      <div class="glow-blob glow-blob--purple" style="width:540px;height:540px;left:50%;top:90%;transform:translate(-50%,-50%);opacity:.4;"></div>
    </div>

    <div data-animate class="max-w-3xl mx-auto px-5 md:px-8 py-28 md:py-36 text-center">
      <span class="mono-label text-labs-green inline-flex items-center gap-2 justify-center">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-labs-green dot-glow text-labs-green"></span>
        Bereit?
      </span>
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-deep-beige leading-[1.06] mt-6">
        Steckt deine Marke an einer Stelle fest, die kein Skill löst?
      </h2>
      <p class="text-lg text-deep-beige/60 leading-relaxed mt-7 max-w-xl mx-auto">
        Genau da fange ich an. Lass uns 15 Minuten reden – unverbindlich und ehrlich.
        Wenn ich nicht der Richtige bin, sage ich dir das.
      </p>
      <div class="mt-10 flex flex-col items-center gap-4">
        <a
          href={ctaCalendly}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 rounded-full bg-deep-beige text-jungle-green font-sans font-semibold text-base md:text-lg px-9 py-4 hover:bg-white transition-all glow-ring"
        >
          Lass uns reden
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <span class="mono-label text-deep-beige/40">15 Min · unverbindlich · kein Pitch</span>
      </div>
    </div>
  </section>
</LabsLayout>
