---
import LabsLayout from '../layouts/LabsLayout.astro';
import SkillPreview from '../components/SkillPreview.astro';
import ClaudeBadge from '../components/ClaudeBadge.astro';
import { skills, GITHUB_REPO_URL, MARKETPLACE } from '../data/skills';
import type { Skill, SkillPreview as Preview } from '../data/skills';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}
interface Props { skill: Skill; }
const { skill } = Astro.props;
const repoSlug = GITHUB_REPO_URL.replace('https://github.com/', '');

const meta = {
  title: `${skill.name} · Edelstein Labs`,
  description: `${skill.subheading} Kostenloser Claude-Skill zum Herunterladen, mit Anleitung für claude.ai und Claude Code.`,
  canonical: `https://labs.edelsteinstrategie.de/${skill.slug}`,
};

const cmdMarketplace = `/plugin marketplace add ${repoSlug}`;
const cmdInstall = `/plugin install ${skill.slug}@${MARKETPLACE}`;
/* The file name can differ from the slug (one plugin can bundle several skills). */
const skillFiles = [skill.downloadUrl, ...(skill.extraDownloads ?? []).map((d) => d.url)]
  .map((url) => url.split('/').pop());
const cmdUnzip =
  skillFiles.length === 1
    ? `unzip ${skillFiles[0]} -d ~/.claude/skills/`
    : `for f in ${skillFiles.join(' ')}; do unzip "$f" -d ~/.claude/skills/; done`;

/* Panel head of the preview: what the snapshot shows, and its state. */
function previewHead(p: Preview): [string, string] {
  switch (p.kind) {
    case 'brand-profile': return ['Brand Profile', 'Extrahiert'];
    case 'script-scene': return [p.scene, p.timecode];
    case 'strategy': return ['Brand Strategy Guide', 'Fertig'];
    case 'voice-profile': return ['VOICE.md', `${p.samples} Proben`];
    case 'pipeline': return [p.label, 'Läuft'];
    case 'prompt': return ['Prompt', 'Optimiert'];
    case 'deck': return [p.cover, 'Entwurf'];
  }
}
const [headLeft, headRight] = previewHead(skill.preview);

/* Strategy steps as a wired node chain; the second node ("Positioning") is active. */
const graph = (() => {
  if (skill.preview.kind !== 'strategy') return null;
  const steps = skill.preview.steps;
  const W = 560, bw = 96, n = steps.length;
  const gapX = n > 1 ? (W - 40 - bw) / (n - 1) : 0;
  const nodes = steps.map((s, i) => ({ s, x: 20 + i * gapX, y: i % 2 ? 84 : 30, on: i === 1 }));
  const wires = nodes.slice(1).map((b, i) => {
    const a = nodes[i];
    return `M${a.x + bw} ${a.y + 18} C ${a.x + bw + 30} ${a.y + 18}, ${b.x - 30} ${b.y + 18}, ${b.x} ${b.y + 18}`;
  });
  return { nodes, wires, bw, label: steps.join(', ') };
})();

const term = [
  { cmd: cmdMarketplace },
  { cmd: cmdInstall },
];
---
<LabsLayout {...meta}>
  <div class="wrap">
    <div class="crumbs mono">
      <a href="/">← Alle Skills</a>
      <span class="d-meta">
        <ClaudeBadge />
        <span class="tagbox"><span class="led"></span>~/skills/{skill.slug}{skill.status !== 'stable' && ' · Beta'}</span>
      </span>
    </div>
  </div>

  <section class="wrap d-hero">
    <div>
      <h1>{skill.name}</h1>
      <p class="d-sub">{skill.subheading}</p>
      <ul class="bul">{skill.bullets.map((b) => <li>{b}</li>)}</ul>
      {skill.note && (
        <div class="d-note"><p class="mono">Wichtig</p><p>{skill.note}</p></div>
      )}
      <div class="btns">
        <a class="btn btn--o" href={skill.downloadUrl} download>Skill herunterladen <span aria-hidden="true">↓</span></a>
        <a class="btn btn--line" href={skill.githubUrl} target="_blank" rel="noopener noreferrer">Auf GitHub <span aria-hidden="true">↗</span></a>
      </div>
      {skill.extraDownloads && skill.extraDownloads.length > 0 && (
        <p class="d-extra">
          Dieses Plugin bündelt mehrere Skills. Für claude.ai zusätzlich laden:
          {skill.extraDownloads.map((d) => <a href={d.url} download>{d.label} ↓</a>)}
        </p>
      )}
    </div>
    <div class="graph">
      <div class="graph-head mono"><span>{headLeft}</span><span><span class="led"></span> {headRight}</span></div>
      {graph && (
        <svg viewBox="0 0 560 150" role="img" aria-label={`Strategie-Bausteine: ${graph.label}`}>
          {graph.wires.map((d, i) => <path class="wire" id={`w${i}`} d={d} />)}
          {graph.wires.map((_, i) => (
            <circle class="pulse" r="3">
              <animateMotion dur="2.4s" begin={`${i * 0.48}s`} repeatCount="indefinite"><mpath href={`#w${i}`} /></animateMotion>
            </circle>
          ))}
          {graph.nodes.map((nd) => (
            <g class={nd.on ? 'node on' : 'node'}>
              <rect x={nd.x} y={nd.y} width={graph.bw} height="36" />
              <text x={nd.x + graph.bw / 2} y={nd.y + 22} text-anchor="middle">{nd.s}</text>
            </g>
          ))}
        </svg>
      )}
      <div class="graph-body"><SkillPreview skill={skill} /></div>
    </div>
  </section>

  <section class="d-sec">
    <div class="wrap d-split"><p class="mono">Das Problem</p><p class="d-big">{skill.problem}</p></div>
  </section>

  <section class="d-sec">
    <div class="wrap d-split">
      <p class="mono">So funktioniert’s</p>
      <ol class="track">
        {skill.howItWorks.map((st, i) => (
          <li>
            <span class="n mono">Schritt {i + 1}</span>
            <h3>{st.title}</h3>
            <p>{st.body}</p>
            {i === 0 && (
              <div class="console">
                <div class="console-head mono"><span>Installation</span><span>claude.ai · Claude Code</span></div>
                <div class="console-body">
                  <div>
                    <span class="mono">claude.ai</span>
                    <p>Die <code class="inl">.skill</code>-Datei herunterladen und im Claude-Projekt unter <strong>Skills</strong> hochladen.</p>
                  </div>
                  <div>
                    <span class="mono">Claude Code</span>
                    <p>Variante a) Plugin-Marketplace:</p>
                    {term.map((t) => (
                      <button type="button" class="term" data-copy={t.cmd}><code>{t.cmd}</code><span data-copy-label>kopieren</span></button>
                    ))}
                    <p style="margin-top:16px">Variante b) Manuell:</p>
                    <button type="button" class="term" data-copy={cmdUnzip}><code>{cmdUnzip}</code><span data-copy-label>kopieren</span></button>
                  </div>
                </div>
                <p class="noclaude"><strong>Kein Claude?</strong> Die <code class="inl">SKILL.md</code> ist einfach Markdown. Kopier ihren Inhalt in ChatGPT, Gemini oder ein beliebiges anderes LLM – funktioniert genauso.</p>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="d-sec">
    <div class="wrap d-split">
      <p class="mono">Beispiel-Ausgabe</p>
      <pre class="sample">{skill.sampleOutput.split('\n').map((l) => <span>{l || ' '}</span>)}</pre>
    </div>
  </section>

  <section class="d-sec quoteband">
    <div class="wrap d-split"><p class="mono">Warum ich das gebaut habe</p><p class="d-big">{skill.whyBuilt}</p></div>
  </section>

  <section class="d-sec">
    <div class="wrap d-split"><p class="mono">Built for</p><div class="chips">{skill.builtFor.map((b) => <span>{b}</span>)}</div></div>
  </section>

  <div class="wrap"><div class="crumbs mono" style="border:0"><a href="/">← Alle Skills</a></div></div>
</LabsLayout>
