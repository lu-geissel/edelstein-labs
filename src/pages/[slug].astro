---
import LabsLayout from '../layouts/LabsLayout.astro';
import SkillPreview from '../components/SkillPreview.astro';
import ClaudeBadge from '../components/ClaudeBadge.astro';
import { skills, GITHUB_REPO_URL, MARKETPLACE } from '../data/skills';
import type { Skill } from '../data/skills';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}
interface Props { skill: Skill; }
const { skill } = Astro.props;
const statusLabel = skill.status === 'stable' ? 'Free' : 'Beta';
const repoSlug = GITHUB_REPO_URL.replace('https://github.com/', '');

const meta = {
  title: `${skill.name} · Edelstein Labs`,
  description: `${skill.subheading} Kostenloser Claude-Skill zum Herunterladen, mit Anleitung für claude.ai und Claude Code.`,
  canonical: `https://labs.edelsteinstrategie.de/${skill.slug}`,
};

const cmdMarketplace = `/plugin marketplace add ${repoSlug}`;
const cmdInstall = `/plugin install ${skill.slug}@${MARKETPLACE}`;
/* Der Dateiname kann vom Slug abweichen (ein Plugin kann mehrere Skills bündeln). */
const skillFiles = [skill.downloadUrl, ...(skill.extraDownloads ?? []).map((d) => d.url)]
  .map((url) => url.split('/').pop());
const cmdUnzip =
  skillFiles.length === 1
    ? `unzip ${skillFiles[0]} -d ~/.claude/skills/`
    : `for f in ${skillFiles.join(' ')}; do unzip "$f" -d ~/.claude/skills/; done`;
---
<LabsLayout {...meta}>
  <!-- ==================== BREADCRUMB ==================== -->
  <div class="max-w-5xl mx-auto px-5 md:px-8 pt-24">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="mono-label text-gem-purple-light hover:text-deep-beige transition-colors inline-flex items-center gap-2">
        <span aria-hidden="true">←</span> Alle Skills
      </a>
      <span class={`inline-flex items-center gap-2 mono-label px-2.5 py-1 border ${skill.status === 'stable' ? 'text-labs-green border-labs-green/30' : 'text-gem-purple-light border-gem-purple-light/30'}`}>
        <span class={`inline-block w-1.5 h-1.5 rounded-full dot-glow ${skill.status === 'stable' ? 'bg-labs-green text-labs-green' : 'bg-gem-purple-light text-gem-purple-light'}`}></span>
        Skill · {statusLabel}
      </span>
    </div>
  </div>

  <!-- ==================== HERO ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 pt-10 pb-16 grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">
    <div data-animate>
      <div class="flex items-center gap-3 flex-wrap">
        <span class="mono-label text-deep-beige/50">{skill.tag}</span>
        <ClaudeBadge size="sm" />
      </div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-[3.4rem] text-deep-beige leading-[1.05] mt-3">
        {skill.name}
      </h1>
      <p class="font-serif text-xl text-deep-beige/70 leading-relaxed mt-5 max-w-xl">
        {skill.subheading}
      </p>
      <ul class="mt-7 space-y-3">
        {skill.bullets.map((b) => (
          <li class="flex items-baseline gap-3 text-deep-beige/80 leading-relaxed">
            <span class="text-gem-purple-light text-xs mt-1.5 shrink-0">●</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      {skill.note && (
        <div class="mt-7 border-l-2 border-gem-purple-light/70 bg-gem-purple/12 pl-5 pr-4 py-4">
          <p class="mono-label text-gem-purple-light mb-2">Wichtig</p>
          <p class="text-deep-beige/75 leading-relaxed">{skill.note}</p>
        </div>
      )}

      <div class="flex flex-col sm:flex-row gap-4 mt-9">
        <a href={skill.downloadUrl} download
           class="inline-flex items-center justify-center gap-2 mono-label text-deep-beige bg-gem-purple hover:bg-gem-purple-light transition-colors px-7 py-4">
          Skill herunterladen <span aria-hidden="true">↓</span>
        </a>
        <a href={skill.githubUrl} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center gap-2 mono-label text-deep-beige/80 border border-deep-beige/25 hover:border-gem-purple-light/70 hover:text-deep-beige transition-colors px-7 py-4">
          Auf GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>

      {skill.extraDownloads && skill.extraDownloads.length > 0 && (
        <p class="text-sm text-deep-beige/55 leading-relaxed mt-5">
          Dieses Plugin bündelt mehrere Skills. Für claude.ai zusätzlich laden:
          {skill.extraDownloads.map((d) => (
            <a href={d.url} download class="text-gem-purple-light hover:text-deep-beige transition-colors ml-1.5 font-mono text-xs">
              {d.label} ↓
            </a>
          ))}
        </p>
      )}
    </div>

    <div data-animate data-delay="150" data-parallax data-depth="8" class="flex justify-center lg:justify-end will-change-transform">
      <SkillPreview skill={skill} />
    </div>
  </section>

  <!-- ==================== PROBLEM ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16">
    <div data-animate>
      <h2 class="font-serif text-2xl md:text-3xl text-deep-beige mb-5 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-gem-purple-light/60"></span> Das Problem
      </h2>
      <p class="text-lg text-deep-beige/65 leading-relaxed max-w-3xl">{skill.problem}</p>
    </div>
  </section>

  <!-- ==================== HOW IT WORKS / INSTALL ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16">
    <h2 data-animate class="font-serif text-2xl md:text-3xl text-deep-beige mb-12 flex items-center gap-3">
      <span class="inline-block w-8 h-px bg-gem-purple-light/60"></span> So funktioniert's
    </h2>

    <div class="space-y-5">
      {skill.howItWorks.map((step, i) => (
        <div data-animate data-delay={i * 100} class="glass p-7 md:p-8">
          <div class="flex items-baseline gap-5">
            <span class="font-mono text-3xl md:text-4xl text-gem-purple-light/40 leading-none shrink-0">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="flex-grow">
              <h3 class="font-serif text-xl text-deep-beige mb-2">{step.title}</h3>
              <p class="text-deep-beige/60 leading-relaxed">{step.body}</p>

              {i === 0 && (
                <div class="grid md:grid-cols-2 gap-5 mt-7">
                  <!-- claude.ai -->
                  <div class="border border-[color:var(--color-labs-line)] p-5">
                    <p class="mono-label text-gem-purple-light/90 mb-3">claude.ai</p>
                    <p class="text-deep-beige/60 text-sm leading-relaxed">
                      Die <code class="font-mono text-deep-beige/80">.skill</code>-Datei herunterladen und im Claude-Projekt unter <span class="text-deep-beige/80">Skills</span> hochladen.
                    </p>
                  </div>
                  <!-- Claude Code -->
                  <div class="border border-[color:var(--color-labs-line)] p-5">
                    <p class="mono-label text-gem-purple-light/90 mb-3">Claude Code</p>
                    <p class="text-deep-beige/60 text-sm leading-relaxed mb-3">Variante a) Plugin-Marketplace:</p>
                    <div class="space-y-2">
                      <button type="button" data-copy={cmdMarketplace}
                        class="group w-full flex items-center justify-between gap-3 bg-black/30 border border-white/10 hover:border-gem-purple-light/50 px-3 py-2.5 text-left transition-colors">
                        <code class="font-mono text-xs text-deep-beige/85 truncate">{cmdMarketplace}</code>
                        <span data-copy-label class="mono-label text-deep-beige/40 group-hover:text-gem-purple-light shrink-0">copy</span>
                      </button>
                      <button type="button" data-copy={cmdInstall}
                        class="group w-full flex items-center justify-between gap-3 bg-black/30 border border-white/10 hover:border-gem-purple-light/50 px-3 py-2.5 text-left transition-colors">
                        <code class="font-mono text-xs text-deep-beige/85 truncate">{cmdInstall}</code>
                        <span data-copy-label class="mono-label text-deep-beige/40 group-hover:text-gem-purple-light shrink-0">copy</span>
                      </button>
                    </div>
                    <p class="text-deep-beige/60 text-sm leading-relaxed mt-4 mb-3">Variante b) Manuell:</p>
                    <button type="button" data-copy={cmdUnzip}
                      class="group w-full flex items-center justify-between gap-3 bg-black/30 border border-white/10 hover:border-gem-purple-light/50 px-3 py-2.5 text-left transition-colors">
                      <code class="font-mono text-xs text-deep-beige/85 truncate">{cmdUnzip}</code>
                      <span data-copy-label class="mono-label text-deep-beige/40 group-hover:text-gem-purple-light shrink-0">copy</span>
                    </button>
                  </div>
                </div>
                <p class="text-deep-beige/55 text-sm leading-relaxed mt-6 border-t border-[color:var(--color-labs-line)] pt-5">
                  <span class="text-gem-purple-light">Kein Claude?</span> Die <code class="font-mono text-deep-beige/80">SKILL.md</code> ist einfach Markdown. Kopier ihren Inhalt in ChatGPT, Gemini oder ein beliebiges anderes LLM – funktioniert genauso.
                </p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== WHY BUILT ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16">
    <div data-animate class="glass-strong p-8 md:p-10">
      <h2 class="font-serif text-2xl md:text-3xl text-deep-beige mb-5">Warum ich das gebaut habe</h2>
      <p class="text-lg text-deep-beige/70 leading-relaxed max-w-3xl">{skill.whyBuilt}</p>
    </div>
  </section>

  <!-- ==================== BUILT FOR ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16">
    <div data-animate>
      <h2 class="mono-label text-gem-purple-light/80 mb-6">Built for</h2>
      <ul class="space-y-3">
        {skill.builtFor.map((item) => (
          <li class="flex items-baseline gap-3 text-deep-beige/80 text-lg">
            <span class="text-gem-purple-light text-xs mt-1.5 shrink-0">●</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== BACK ==================== -->
  <section class="max-w-5xl mx-auto px-5 md:px-8 py-12">
    <a href="/" class="mono-label text-gem-purple-light hover:text-deep-beige transition-colors inline-flex items-center gap-2">
      <span aria-hidden="true">←</span> Alle Skills
    </a>
  </section>
</LabsLayout>
