---
import fs from 'node:fs';
import type { Skill } from '../data/skills';
interface Props { skill: Skill; }
const { skill } = Astro.props;

/* Tiles without stock footage get a typographic fallback instead of an empty box. */
const hasVideo = fs.existsSync(
  new URL(`../../public/labs/video/tile-${skill.slug}.mp4`, import.meta.url),
);
const initials = skill.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<a class="mod" href={`/${skill.slug}`}>
  <span class="screen">
    {hasVideo ? (
      <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"
             poster={`/labs/video/tile-${skill.slug}.jpg`}>
        <source src={`/labs/video/tile-${skill.slug}.webm`} type="video/webm" />
        <source src={`/labs/video/tile-${skill.slug}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <span class="screen-fallback" aria-hidden="true">{initials}</span>
    )}
    <span class="scan"></span>
  </span>
  <span class="mod-body">
    <span class="mod-id">
      <span>~/skills/<b>{skill.slug}</b></span>
      {skill.status !== 'stable' && <span>Beta</span>}
    </span>
    <h3>{skill.name}</h3>
    <p>{skill.tagline}</p>
    <span class="sig">{skill.triggers.slice(0, 3).map((t) => <span>{t}</span>)}</span>
    <span class="more mono"><span>Details ansehen</span><i aria-hidden="true">↗</i></span>
  </span>
</a>
