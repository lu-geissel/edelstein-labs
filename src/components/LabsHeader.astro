---
import { GITHUB_REPO_URL } from '../data/skills';
import { texts, localizeHref } from '../i18n';
import LanguageSwitch from './LanguageSwitch.astro';
const locale = Astro.currentLocale;
const common = texts('common', locale);
const t = common.header;
---
<header class="hdr">
  <div class="wrap">
    <a class="lockup" href={localizeHref('/', locale)} aria-label={t.logoHome}>
      <img src="/brand/edelstein-wordmark.svg" alt={t.logoAlt} width="60" height="33" />
      <span class="mono">{t.badge}</span>
    </a>
    <nav class="nav mono" aria-label={t.main}>
      <a class="hide-s" href={localizeHref('/#skills', locale)}>{t.skills}</a>
      <a class="hide-s" href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">{t.github}</a>
      <LanguageSwitch />
      <a class="ext" href={common.site.mainSiteUrl}>{t.mainSite}</a>
    </nav>
  </div>
</header>
