---
import fs from 'node:fs';

/**
 * "Works with Claude" — referenzieller Hinweis, kein Absender.
 *
 * Das offizielle Claude-Logo liegt NICHT im Repo. Lade es aus Anthropics
 * Brand-Assets (brandfolder.com/anthropic) und speichere es als
 *   public/brand/claude-logo.svg
 * Dann erscheint es hier automatisch. Solange die Datei fehlt, rendert der
 * Badge nur den Text — korrekt, nur ohne Bildmarke. Ein nachgebautes Logo
 * kommt hier nie rein.
 *
 * Guideline-konform: Der Badge ist eine helle, neutrale Fläche (das Logo ist
 * für helle Untergründe gebaut), das Logo wird nur uniform skaliert, nie
 * verzerrt oder rotiert, und hat Freiraum in Höhe seiner selbst.
 */
const logoPath = new URL('../../public/brand/claude-logo.svg', import.meta.url);
const logoSvg = fs.existsSync(logoPath) ? fs.readFileSync(logoPath, 'utf-8') : null;
---
<span class="claude-badge" title="Diese Skills laufen in Claude – ohne Verbindung zu Anthropic.">
  {logoSvg && <span class="glyph" aria-hidden="true" set:html={logoSvg} />}
  <span class="mono">Works with Claude</span>
</span>
