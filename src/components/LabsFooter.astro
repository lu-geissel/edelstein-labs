---
import { MAIN_SITE, GITHUB_REPO_URL } from '../data/skills';
const year = 2026;
---
<footer class="relative border-t border-[color:var(--color-labs-line)] mt-24">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-12 flex flex-col md:flex-row md:items-center justify-between gap-8">
    <div>
      <a href="/" class="flex items-center gap-3">
        <span class="font-signature text-4xl leading-none text-gem-purple-light">Edelstein</span>
        <span class="mono-label text-deep-beige/70 border border-deep-beige/25 px-1.5 py-0.5 leading-none">LABS</span>
      </a>
      <p class="mt-3 text-sm text-deep-beige/45 max-w-sm leading-relaxed">
        Selbstgebaute AI-Skills für Marken- und Content-Arbeit. Kostenlos, out-of-the-box, ohne Interna.
      </p>
    </div>

    <nav class="flex flex-wrap items-center gap-x-7 gap-y-3">
      <a href={MAIN_SITE} class="mono-label text-deep-beige/60 hover:text-deep-beige transition-colors">Edelstein ↗</a>
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer" class="mono-label text-deep-beige/60 hover:text-deep-beige transition-colors">GitHub</a>
      <a href={`${MAIN_SITE}/impressum`} class="mono-label text-deep-beige/60 hover:text-deep-beige transition-colors">Impressum</a>
      <a href={`${MAIN_SITE}/datenschutz`} class="mono-label text-deep-beige/60 hover:text-deep-beige transition-colors">Datenschutz</a>
    </nav>
  </div>
  <div class="max-w-6xl mx-auto px-5 md:px-8 pb-10">
    <p class="mono-label text-deep-beige/30">© {year} Luis Geißelhardt · Edelstein Labs</p>
  </div>
</footer>
