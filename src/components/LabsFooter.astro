---
import { MAIN_SITE, GITHUB_REPO_URL } from '../data/skills';
const year = 2026;
---
<footer class="ftr">
  <div class="wrap">
    <div>
      <a class="lockup" href="/" aria-label="Edelstein Labs – Startseite">
        <img src="/brand/edelstein-wordmark.svg" alt="Edelstein" width="60" height="33" />
        <span class="mono">Labs</span>
      </a>
      <p>Selbstgebaute AI-Skills für Marken- und Content-Arbeit. Kostenlos, out-of-the-box, ohne Interna.</p>
    </div>
    <nav class="mono" aria-label="Footer">
      <a href={MAIN_SITE}>Edelstein ↗</a>
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={`${MAIN_SITE}/impressum`}>Impressum</a>
      <a href={`${MAIN_SITE}/datenschutz`}>Datenschutz</a>
    </nav>
    <p class="copy mono">© {year} Luis Geißelhardt · Edelstein Labs</p>
  </div>
</footer>
