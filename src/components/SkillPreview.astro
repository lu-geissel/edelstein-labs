---
/* Snapshot of what the skill produces, shown in the detail hero. The panel head
   (label + state) is rendered by the page; strategy steps are drawn as the node graph. */
import type { Skill } from '../data/skills';
interface Props { skill: Skill; }
const { skill } = Astro.props;
const p = skill.preview;
---
<div class="pv">
  {p.kind === 'brand-profile' && (
    <Fragment>
      <div class="pv-swatches">
        {p.colors.map((c) => (
          <div><span class="pv-swatch" style={`background:${c.hex}`}></span><span class="pv-label">{c.label}</span><code>{c.hex}</code></div>
        ))}
      </div>
      <dl class="pv-rows">
        <div><dt class="pv-label">Headline</dt><dd class="pv-serif">{p.fonts.headline}</dd></div>
        <div><dt class="pv-label">Body</dt><dd>{p.fonts.body}</dd></div>
      </dl>
      <div class="pv-chips">{p.tones.map((t) => <span>{t}</span>)}</div>
    </Fragment>
  )}

  {p.kind === 'script-scene' && (
    <Fragment>
      <div><span class="pv-label">Sprechertext</span><p class="pv-serif pv-big">{p.voiceover}</p></div>
      <div><span class="pv-label">Animation</span><p class="pv-small">{p.animation}</p></div>
      <div class="pv-meter"><span><i style="width:34%"></i></span><span class="pv-label">{p.words} Wörter</span></div>
    </Fragment>
  )}

  {p.kind === 'strategy' && (
    <Fragment>
      <div><span class="pv-label">Substance</span><p class="pv-serif pv-big">{p.substance}</p></div>
      <div class="pv-rule"><span class="pv-label pv-accent">Positioning</span><p class="pv-small">{p.positioning}</p></div>
    </Fragment>
  )}

  {p.kind === 'voice-profile' && (
    <Fragment>
      <div><span class="pv-label">Voice DNA</span><p class="pv-serif pv-big">{p.dna}</p></div>
      <div class="pv-cols">
        <div><span class="pv-label pv-accent">Nutzt</span><ul class="pv-words">{p.uses.map((w) => <li>{w}</li>)}</ul></div>
        <div><span class="pv-label">Vermeidet</span><ul class="pv-words pv-words--off">{p.avoids.map((w) => <li><s>{w}</s></li>)}</ul></div>
      </div>
    </Fragment>
  )}

  {p.kind === 'pipeline' && (
    <Fragment>
      <ol class="pv-pipe">
        {p.steps.map((s) => (
          <li class={`is-${s.state}`}><i></i><span>{s.name}</span><em>{s.state === 'gate' ? 'wartet' : s.state === 'done' ? 'ok' : ''}</em></li>
        ))}
      </ol>
      <p class="pv-small pv-rule">{p.note}</p>
    </Fragment>
  )}

  {p.kind === 'prompt' && (
    <Fragment>
      <div><span class="pv-label">Vorher</span><p class="pv-mono pv-off">{p.before}</p></div>
      <div><span class="pv-label pv-accent">Nachher</span><p class="pv-small pv-on">{p.after}</p></div>
    </Fragment>
  )}

  {p.kind === 'deck' && (
    <Fragment>
      <div class="pv-slides">
        {p.slides.map((s) => <div><strong class="pv-serif">{s.title}</strong><span class="pv-small">{s.body}</span></div>)}
      </div>
      <div class="pv-rule"><span class="pv-label pv-accent">Offene Frage</span><p class="pv-small">{p.open}</p></div>
    </Fragment>
  )}
</div>
