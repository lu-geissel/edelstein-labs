---
import type { Skill } from '../data/skills';
interface Props { skill: Skill; }
const { skill } = Astro.props;
const p = skill.preview;
---
<div class="glass-strong shimmer-host p-6 md:p-7 w-full max-w-md">
  {p.kind === 'brand-profile' && (
    <div>
      <div class="flex items-center justify-between mb-6">
        <span class="mono-label text-deep-beige/55">Brand Profile</span>
        <span class="mono-label text-gem-purple-light flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gem-purple-light dot-glow text-gem-purple-light"></span>
          Extracted
        </span>
      </div>

      <div class="grid grid-cols-3 gap-3 mb-6">
        {p.colors.map((c, i) => (
          <div data-animate data-delay={120 + i * 120} class="flex flex-col gap-2">
            <div class="h-14 border border-white/10" style={`background:${c.hex}`}></div>
            <div class="leading-tight">
              <div class="mono-label text-deep-beige/70">{c.label}</div>
              <div class="font-mono text-[0.65rem] text-deep-beige/40">{c.hex}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-2.5 mb-6">
        <div class="flex items-baseline justify-between border-b border-white/5 pb-2">
          <span class="mono-label text-deep-beige/45">Headline</span>
          <span class="font-serif text-lg text-deep-beige">{p.fonts.headline}</span>
        </div>
        <div class="flex items-baseline justify-between border-b border-white/5 pb-2">
          <span class="mono-label text-deep-beige/45">Body</span>
          <span class="font-sans text-base text-deep-beige/90">{p.fonts.body}</span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        {p.tones.map((t, i) => (
          <span data-animate data-delay={400 + i * 100}
                class="mono-label text-gem-purple-light/90 border border-gem-purple-light/30 px-2 py-1">{t}</span>
        ))}
      </div>
    </div>
  )}

  {p.kind === 'script-scene' && (
    <div>
      <div class="flex items-center justify-between mb-5">
        <span class="mono-label text-deep-beige/55">{p.scene}</span>
        <span class="mono-label text-deep-beige/40">{p.timecode}</span>
      </div>

      <div class="mb-5">
        <div class="mono-label text-gem-purple-light/80 mb-2">Sprechertext</div>
        <p class="font-serif text-lg md:text-xl text-deep-beige leading-snug min-h-[3.5rem]"
           data-typewriter data-speed="34">{p.voiceover}</p>
      </div>

      <div class="mb-6">
        <div class="mono-label text-deep-beige/40 mb-2">Animation</div>
        <p class="text-sm text-deep-beige/55 leading-relaxed">{p.animation}</p>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex-1 h-1 bg-white/8 overflow-hidden">
          <div class="h-full w-[34%] bg-gem-purple-light/80"></div>
        </div>
        <span class="mono-label text-deep-beige/45 shrink-0">{p.words} Wörter</span>
      </div>
    </div>
  )}

  {p.kind === 'strategy' && (
    <div>
      <div class="flex items-center justify-between mb-5">
        <span class="mono-label text-deep-beige/55">Brand Strategy Guide</span>
        <span class="mono-label text-gem-purple-light flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gem-purple-light dot-glow text-gem-purple-light"></span>
          Ready
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-1.5 mb-6">
        {p.steps.map((s, i) => (
          <span data-animate data-delay={120 + i * 110}
                class={`mono-label px-2 py-1 border ${i === 1 ? 'text-deep-beige border-gem-purple-light/60 bg-gem-purple/25' : 'text-deep-beige/45 border-white/10'}`}>{s}</span>
        ))}
      </div>

      <div class="space-y-4">
        <div>
          <div class="mono-label text-deep-beige/40 mb-1.5">Substance</div>
          <p class="font-serif text-base text-deep-beige leading-snug">{p.substance}</p>
        </div>
        <div class="border-t border-white/5 pt-4">
          <div class="mono-label text-gem-purple-light/80 mb-1.5">Positioning</div>
          <p class="text-sm text-deep-beige/70 leading-relaxed">{p.positioning}</p>
        </div>
      </div>
    </div>
  )}
</div>
